<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- iisnode handler for Node.js - Angular SSR server -->
    <handlers>
      <add name="iisnode" path="server/server.mjs" verb="*" modules="iisnode" />
    </handlers>

    <!-- Static files live in browser/ and are served by IIS. HTML routes go to Node. -->
    <!-- <rewrite>
      <rules>
        <rule name="NodeApp" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server/server.mjs" />
        </rule>
      </rules>
    </rewrite> -->

    <rewrite>
      <rules>
        <!-- GEOAPI is a sibling app; never send it to this Node process -->
        <rule name="ExcludeGEOAPI" stopProcessing="true">
          <match url="^GEOAPI/.*" />
          <action type="None" />
        </rule>

        <!-- Bundles are emitted under browser/, not the IIS site root.
             Map the request there first. If that path is a real file, the
             next rule does not run and IIS serves the asset with its real
             MIME type. Without this, scripts-*.js is rewritten to Node and
             the login HTML is returned (Unexpected token '<'). -->
        <rule name="BrowserStatic" stopProcessing="false">
          <match url=".*" />
          <action type="Rewrite" url="browser/{R:0}" />
        </rule>

        <rule name="NodeApp" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server/server.mjs" />
        </rule>
      </rules>
    </rewrite>

    <!-- iisnode settings -->
    <iisnode
      nodeProcessCommandLine="&quot;%ProgramFiles%\nodejs\node.exe&quot;"
      node_env="production"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      devErrorsEnabled="true" />

    <!-- Security: deny access to sensitive paths -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- IIS has no built-in mapping for .geojson and otherwise returns 404.3 -->
    <staticContent>
      <mimeMap fileExtension=".geojson" mimeType="application/geo+json" />
    </staticContent>

    <!-- Pass through response from Node -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
